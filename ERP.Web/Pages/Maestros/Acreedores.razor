@page "/maestros/acreedores"
@using ERP.Domain.Entities
@inject HttpClient Http
@inject IJSRuntime JS
@inject NavigationManager Nav

<div class="max-w-[1400px] mx-auto p-6 animate-in fade-in duration-700">

    @* --- CABECERA --- *@
    <div class="flex justify-between items-end mb-8 border-b border-slate-200 pb-6">
        <div>
            <nav class="text-[10px] font-black text-slate-600 uppercase mb-2 tracking-widest">Maestros > Acreedores</nav>
            <h1 class="text-4xl font-black text-slate-900 uppercase tracking-tighter italic">Cartera de Acreedores</h1>
        </div>
        <button @onclick="NuevoAcreedor" class="bg-slate-900 hover:bg-blue-600 text-white px-8 py-3 rounded-xl font-black text-xs transition-all shadow-xl flex items-center gap-3 uppercase tracking-widest active:scale-95">
            <span class="text-lg">＋</span> Alta Acreedor
        </button>
    </div>

    @* --- BARRA DE BÚSQUEDA --- *@
    <div class="bg-slate-50 p-2 rounded-2xl mb-8 flex items-center gap-2 border border-slate-200/60 shadow-inner">
        <input type="text" @bind="searchTerm" @bind:event="oninput" @onkeyup="Filtrar"
               placeholder="Buscar por CIF, Razón Social o Contacto..." 
               class="flex-1 pl-6 pr-4 py-3 bg-white border-none rounded-xl text-sm shadow-sm focus:ring-2 focus:ring-blue-500/20 outline-none transition" />
        
        <select @bind="filtroTipo" @bind:event="onchange"
                class="bg-white border-none rounded-xl py-3 px-6 text-[10px] font-black text-slate-500 shadow-sm outline-none cursor-pointer">
            <option value="TODOS">TODOS</option>
            <option value="ACREEDOR">SOLO ACREEDORES</option>
        </select>
    </div>

    @* --- GRID DE DATOS --- *@
    <div class="bg-white rounded-2xl shadow-sm border border-slate-200 overflow-hidden">
        @if (acreedoresFiltrados == null)
        {
            <div class="p-20 text-center">
                <div class="animate-spin h-8 w-8 border-4 border-blue-600 border-t-transparent rounded-full mx-auto mb-4"></div>
                <p class="text-[10px] font-black text-slate-400 uppercase">Sincronizando acreedores...</p>
            </div>
        }
        else
        {
            <table class="w-full text-left">
                <thead class="bg-slate-50/50 border-b border-slate-100">
                    <tr class="text-[10px] font-black text-slate-400 uppercase tracking-widest">
                        <th class="p-5">Entidad / CIF</th>
                        <th class="p-5">Contacto Principal</th>
                        <th class="p-5">Tipo</th>
                        <th class="p-5 text-center">Estado</th>
                        <th class="p-5 text-right">Acciones</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-50">
                    @foreach (var acre in acreedoresFiltrados)
                    {
                        <tr class="hover:bg-slate-50/80 transition-colors group">
                            <td class="p-5">
                                <div class="text-sm font-black text-slate-800 uppercase tracking-tight">@acre.RazonSocial</div>
                                <div class="text-[10px] font-mono text-blue-600">@acre.CIF</div>
                            </td>
                            <td class="p-5">
                                <div class="text-xs font-bold text-slate-700">@(acre.NombreContacto ?? "Sin contacto")</div>
                                <div class="text-[10px] text-slate-400">@acre.Email | @acre.Telefono</div>
                            </td>
                            <td class="p-5">
                                <span class="text-[9px] font-black text-amber-600 bg-amber-50 px-2 py-1 rounded border border-amber-100 uppercase">Acreedor / Gastos</span>
                            </td>
                            <td class="p-5 text-center">
                                @if (acre.IsActivo)
                                {
                                    <span class="bg-emerald-50 text-emerald-600 px-3 py-1 rounded-full text-[9px] font-black uppercase tracking-widest border border-emerald-100">✓ Activo</span>
                                }
                                else
                                {
                                    <span class="bg-slate-100 text-slate-400 px-3 py-1 rounded-full text-[9px] font-black uppercase tracking-widest">✕ Inactivo</span>
                                }
                            </td>
                            <td class="p-5 text-right">
                                <div class="flex justify-end gap-1 opacity-0 group-hover:opacity-100 transition-opacity">
                                    <button @onclick="() => Editar(acre.Id)" class="p-2 hover:bg-slate-900 hover:text-white rounded-lg transition-all">✏️</button>
                                    <button @onclick="() => Eliminar(acre.Id)" class="p-2 hover:bg-red-600 hover:text-white rounded-lg transition-all">🗑️</button>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>

    @* --- DRAWER DE FORMULARIO (MODAL LATERAL) --- *@
    @if (mostrarFormulario)
    {
        <div class="fixed inset-0 bg-slate-900/40 backdrop-blur-sm z-50 flex justify-end">
            <div class="w-full max-w-2xl bg-white h-full shadow-2xl animate-in slide-in-from-right duration-300 flex flex-col">
                <div class="p-8 border-b border-slate-100 flex justify-between items-center">
                    <div>
                        <h2 class="text-2xl font-black text-slate-900 uppercase tracking-tighter">Ficha de Acreedor</h2>
                        <p class="text-[10px] font-bold text-slate-400 uppercase tracking-widest">Datos de Contacto y Condiciones</p>
                    </div>
                    <button @onclick="CerrarFormulario" class="h-10 w-10 flex items-center justify-center rounded-full hover:bg-slate-100 text-slate-400">✕</button>
                </div>

                <div class="flex-1 overflow-y-auto p-10">
                    <EditForm Model="acreedorActual" OnValidSubmit="GuardarAcreedor">
                        <DataAnnotationsValidator />
                        
                        <div class="space-y-8">
                            <div class="grid grid-cols-2 gap-6">
                                <div class="col-span-2">
                                    <label class="text-[10px] font-black text-slate-400 uppercase mb-2 block tracking-widest">Razón Social</label>
                                    <InputText @bind-Value="acreedorActual.RazonSocial" class="w-full p-4 bg-slate-50 border border-slate-200 rounded-xl font-bold uppercase focus:ring-2 focus:ring-blue-500/20 outline-none transition" />
                                    <ValidationMessage For="@(() => acreedorActual.RazonSocial)" class="text-blue-600 text-[10px] font-bold uppercase mt-1" />
                                </div>
                                <div>
                                    <label class="text-[10px] font-black text-slate-400 uppercase mb-2 block tracking-widest">CIF / NIF</label>
                                    <InputText @bind-Value="acreedorActual.CIF" class="w-full p-4 bg-slate-50 border border-slate-200 rounded-xl font-mono uppercase focus:ring-2 focus:ring-blue-500/20 outline-none transition" />
                                    <ValidationMessage For="@(() => acreedorActual.CIF)" class="text-blue-600 text-[10px] font-bold uppercase mt-1" />
                                </div>
                            </div>

                            <div class="grid grid-cols-2 gap-6 pt-4">
                                <div>
                                    <label class="text-[10px] font-black text-slate-400 uppercase mb-2 block tracking-widest">Tipo Contable</label>
                                    <div class="flex h-[58px] bg-slate-100 p-1 rounded-xl">
                                        <button type="button" @onclick="() => acreedorActual.EsAcreedor = false" class="flex-1 rounded-lg text-[9px] font-black uppercase transition-all @(!acreedorActual.EsAcreedor ? "bg-white text-slate-900 shadow-sm" : "text-slate-400")">Mercancía</button>
                                        <button type="button" @onclick="() => acreedorActual.EsAcreedor = true" class="flex-1 rounded-lg text-[9px] font-black uppercase transition-all @(acreedorActual.EsAcreedor ? "bg-white text-slate-900 shadow-sm" : "text-slate-400")">Servicios</button>
                                    </div>
                                </div>
                                <div>
                                    <label class="text-[10px] font-black text-slate-400 uppercase mb-2 block tracking-widest">Es Acreedor</label>
                                    <InputCheckbox @bind-Value="acreedorActual.EsAcreedor" class="h-5 w-5 rounded text-blue-600 focus:ring-blue-500" />
                                </div>
                            </div>

                            <div class="pt-8 border-t border-slate-100 space-y-6">
                                <div>
                                    <label class="text-[10px] font-black text-slate-400 uppercase mb-2 block tracking-widest">Persona de Contacto</label>
                                    <InputText @bind-Value="acreedorActual.NombreContacto" class="w-full p-4 bg-slate-50 border border-slate-200 rounded-xl focus:ring-2 focus:ring-blue-500/20 outline-none transition" />
                                </div>
                                <div class="grid grid-cols-2 gap-6">
                                    <div>
                                        <label class="text-[10px] font-black text-slate-400 uppercase mb-2 block tracking-widest">Teléfono</label>
                                        <InputText @bind-Value="acreedorActual.Telefono" class="w-full p-4 bg-slate-50 border border-slate-200 rounded-xl focus:ring-2 focus:ring-blue-500/20 outline-none transition" />
                                    </div>
                                    <div>
                                        <label class="text-[10px] font-black text-slate-400 uppercase mb-2 block tracking-widest">Email</label>
                                        <InputText @bind-Value="acreedorActual.Email" class="w-full p-4 bg-slate-50 border border-slate-200 rounded-xl focus:ring-2 focus:ring-blue-500/20 outline-none transition" />
                                    </div>
                                </div>
                            </div>

                            <div class="p-4 bg-slate-50 rounded-2xl flex items-center gap-3 border border-slate-200/50">
                                <InputCheckbox @bind-Value="acreedorActual.IsActivo" class="h-5 w-5 rounded text-blue-600 focus:ring-blue-500" />
                                <span class="text-[10px] font-black text-slate-700 uppercase tracking-widest">Acreedor Activo</span>
                            </div>

                            <div class="flex gap-4 pt-6">
                                <button type="submit" class="flex-1 bg-slate-900 text-white py-5 rounded-2xl font-black text-xs uppercase tracking-widest hover:bg-blue-600 transition-all shadow-xl active:scale-95">
                                    Guardar Acreedor
                                </button>
                                <button type="button" @onclick="CerrarFormulario" class="px-8 bg-slate-100 text-slate-500 rounded-2xl font-black text-xs uppercase hover:bg-slate-200 transition-all">
                                    Cancelar
                                </button>
                            </div>
                        </div>
                    </EditForm>
                </div>
            </div>
        </div>
    }
</div>

@code {
    private List<Acreedor>? acreedores;
    private List<Acreedor> acreedoresFiltrados = new();
    private string searchTerm = "";
    private string filtroTipo = "TODOS";
    private bool mostrarFormulario = false;
    private Acreedor acreedorActual = new();

    protected override async Task OnInitializedAsync()
    {
        await CargarAcreedores();
    }

    private async Task CargarAcreedores()
    {
        try {
            acreedores = await Http.GetFromJsonAsync<List<Acreedor>>("api/acreedores");
            Filtrar();
            if (acreedores == null || !acreedores.Any()) {
                await Notificar("No hay acreedores en la base de datos.", "error");
            }
        } catch (HttpRequestException ex) when (ex.Message.Contains("401") || ex.StatusCode == System.Net.HttpStatusCode.Unauthorized) {
            await NavToLogin();
        } catch (HttpRequestException ex) {
            await Notificar($"Error de conexión: {ex.Message}", "error");
        } catch {
            await Notificar("Error inesperado al cargar acreedores", "error");
        }
    }

    private async Task NavToLogin() {
        await Task.Delay(800);
        Nav.NavigateTo("/login", forceLoad: true);
    }

    private void Filtrar()
    {
        if (acreedores == null) return;
        
        var s = searchTerm.ToLower();
        var temp = acreedores.Where(a => 
            a.RazonSocial.ToLower().Contains(s) || 
            a.CIF.ToLower().Contains(s) || 
            (a.NombreContacto?.ToLower().Contains(s) ?? false)
        ).ToList();

        if (filtroTipo == "ACREEDOR") temp = temp.Where(a => a.EsAcreedor).ToList();
        
        acreedoresFiltrados = temp;
        StateHasChanged();
    }

    private void NuevoAcreedor() { 
        acreedorActual = new Acreedor { IsActivo = true, EsAcreedor = true }; 
        mostrarFormulario = true; 
    }
    
    private async Task Editar(int id) { 
        try {
            acreedorActual = await Http.GetFromJsonAsync<Acreedor>($"api/acreedores/{id}") ?? new(); 
            mostrarFormulario = true; 
        } catch {
            await Notificar("No se pudo recuperar la ficha del acreedor", "error");
        }
    }

    private void CerrarFormulario() => mostrarFormulario = false;

    private async Task GuardarAcreedor()
    {
        try {
            HttpResponseMessage response;
            if (acreedorActual.Id == 0) 
                response = await Http.PostAsJsonAsync("api/acreedores", acreedorActual);
            else 
                response = await Http.PutAsJsonAsync($"api/acreedores/{acreedorActual.Id}", acreedorActual);

            if (response.IsSuccessStatusCode) {
                await Notificar("Base de datos de acreedores actualizada", "success");
                await CargarAcreedores();
                CerrarFormulario();
            } else {
                await Notificar("Error al guardar los datos", "error");
            }
        } catch {
            await Notificar("Fallo en la comunicación con el servidor", "error");
        }
    }

    private async Task Eliminar(int id)
    {
        var confirm = await JS.InvokeAsync<bool>("confirm", "¿Desea desactivar este acreedor de la cartera activa?");
        if (confirm) {
            var response = await Http.DeleteAsync($"api/acreedores/{id}");
            if (response.IsSuccessStatusCode) {
                await Notificar("Acreedor dado de baja", "success");
                await CargarAcreedores();
            } else {
                await Notificar("Error al procesar la baja", "error");
            }
        }
    }

    private async Task Notificar(string msg, string tipo) => await JS.InvokeVoidAsync("showToast", msg, tipo);
}