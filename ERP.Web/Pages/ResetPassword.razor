@page "/reset-password"
@layout EmptyLayout
@using Microsoft.AspNetCore.Components
@using ERP.Web.Services
@inject AuthService AuthService
@inject NavigationManager NavigationManager
@inject NotificationService NotificationService

<div class="min-h-screen w-full flex items-center justify-center bg-[#020617] p-6">
    <div class="w-full max-w-md bg-[#0f172a] rounded-3xl shadow-2xl border border-slate-800/50 p-8">
        <div class="flex flex-col items-center mb-8">
            <div class="w-16 h-16 bg-emerald-600 rounded-2xl flex items-center justify-center text-white text-2xl font-black shadow-xl shadow-emerald-500/20 mb-4 ring-1 ring-white/20">
                <i class="bi bi-key-fill"></i>
            </div>
            <h1 class="text-xl font-black text-white tracking-tight uppercase">Nueva <span class="text-emerald-500">contraseña</span></h1>
            <p class="text-slate-500 text-[11px] font-bold tracking-wide mt-2 text-center">Introduce tu nueva contraseña</p>
        </div>

        @if (string.IsNullOrWhiteSpace(Email) || string.IsNullOrWhiteSpace(Token))
        {
            <div class="bg-amber-500/10 border border-amber-500/20 text-amber-400 text-[12px] p-4 rounded-xl text-center">
                Enlace no válido o incompleto. Solicita de nuevo el correo de recuperación en <a href="forgot-password" class="underline font-bold">"¿Has olvidado tu contraseña?"</a>
            </div>
            <button @onclick='() => NavigationManager.NavigateTo("forgot-password")' class="mt-6 w-full bg-blue-600 hover:bg-blue-500 text-white font-black text-[11px] uppercase tracking-[0.2em] py-3 rounded-xl">Solicitar nuevo correo</button>
        }
        else if (completado)
        {
            <div class="bg-emerald-500/10 border border-emerald-500/20 text-emerald-400 text-[12px] p-4 rounded-xl text-center">
                <i class="bi bi-check-circle-fill text-lg block mb-2"></i>
                Contraseña restablecida correctamente. Ya puedes iniciar sesión.
            </div>
            <button @onclick='() => NavigationManager.NavigateTo("login")' class="mt-6 w-full bg-blue-600 hover:bg-blue-500 text-white font-black text-[11px] uppercase tracking-[0.2em] py-3 rounded-xl">Ir al login</button>
        }
        else
        {
            <div class="mb-4 bg-slate-900/50 border border-slate-800 rounded-xl p-3 text-[11px] text-slate-400">
                <i class="bi bi-envelope"></i> @Email
            </div>
            <EditForm Model="@model" OnValidSubmit="HandleReset">
                <DataAnnotationsValidator />
                <div class="space-y-5">
                    <div>
                        <label class="block text-[10px] font-black text-slate-500 uppercase tracking-widest mb-2 ml-1">Nueva contraseña</label>
                        <div class="relative">
                            <i class="bi bi-shield-lock absolute left-4 top-1/2 -translate-y-1/2 text-slate-500"></i>
                            <InputText @bind-Value="model.NewPassword" type="password" class="w-full bg-slate-900/50 border border-slate-800 text-white pl-12 pr-4 py-3 rounded-xl focus:ring-2 focus:ring-emerald-500 outline-none placeholder:text-slate-700" placeholder="Min. 8 chars, mayúscula, número y símbolo" />
                        </div>
                        <ValidationMessage For="@(() => model.NewPassword)" class="text-red-500 text-[10px] mt-1 font-bold" />
                    </div>
                    <div>
                        <label class="block text-[10px] font-black text-slate-500 uppercase tracking-widest mb-2 ml-1">Confirmar contraseña</label>
                        <div class="relative">
                            <i class="bi bi-shield-check absolute left-4 top-1/2 -translate-y-1/2 text-slate-500"></i>
                            <InputText @bind-Value="model.ConfirmPassword" type="password" class="w-full bg-slate-900/50 border border-slate-800 text-white pl-12 pr-4 py-3 rounded-xl focus:ring-2 focus:ring-emerald-500 outline-none placeholder:text-slate-700" placeholder="Repite la contraseña" />
                        </div>
                        <ValidationMessage For="@(() => model.ConfirmPassword)" class="text-red-500 text-[10px] mt-1 font-bold" />
                    </div>

                    @if (!string.IsNullOrEmpty(errorMessage))
                    {
                        <div class="bg-red-500/10 border border-red-500/20 text-red-500 text-[11px] p-3 rounded-xl">@errorMessage</div>
                    }

                    <button type="submit" disabled="@isSubmitting" class="w-full bg-emerald-600 hover:bg-emerald-500 disabled:bg-slate-800 text-white font-black text-[11px] uppercase tracking-[0.2em] py-4 rounded-xl shadow-lg shadow-emerald-900/20 transition flex items-center justify-center gap-2">
                        @if (isSubmitting) { <div class="w-4 h-4 border-2 border-white/30 border-t-white rounded-full animate-spin"></div><span>Guardando...</span> } else { <span>Cambiar contraseña</span><i class="bi bi-check-lg"></i> }
                    </button>

                    <div class="text-center">
                        <a href="login" class="text-[11px] text-slate-500 hover:text-white hover:underline">Volver al login</a>
                    </div>
                </div>
            </EditForm>
        }

        <p class="mt-8 text-center text-slate-600 text-[10px]">&copy; 2026 ERP Industrial.</p>
    </div>
</div>

@code {
    [Parameter]
    [SupplyParameterFromQuery(Name = "email")]
    public string? Email { get; set; }

    [Parameter]
    [SupplyParameterFromQuery(Name = "token")]
    public string? Token { get; set; }

    private ResetModel model = new();
    private bool isSubmitting = false;
    private bool completado = false;
    private string? errorMessage;

    private async Task HandleReset()
    {
        if (string.IsNullOrWhiteSpace(Email) || string.IsNullOrWhiteSpace(Token)) return;
        isSubmitting = true;
        errorMessage = null;
        try
        {
            var (ok, message) = await AuthService.ResetPassword(Email!, Token!, model.NewPassword, model.ConfirmPassword);
            if (ok)
            {
                completado = true;
                NotificationService.Success("Contraseña cambiada correctamente.");
            }
            else
            {
                // Extraer Message del JSON si viene
                try
                {
                    var doc = System.Text.Json.JsonDocument.Parse(message);
                    if (doc.RootElement.TryGetProperty("Message", out var m)) errorMessage = m.GetString();
                    else if (doc.RootElement.TryGetProperty("message", out var m2)) errorMessage = m2.GetString();
                    else errorMessage = message;
                }
                catch { errorMessage = message; }
                if (string.IsNullOrWhiteSpace(errorMessage)) errorMessage = "No se pudo restablecer la contraseña. El enlace puede haber expirado.";
                NotificationService.Error(errorMessage);
            }
        }
        catch (Exception ex)
        {
            errorMessage = "Error de conexión.";
            Console.WriteLine($"Reset error: {ex.Message}");
        }
        finally { isSubmitting = false; }
    }

    public class ResetModel
    {
        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "La nueva contraseña es obligatoria")]
        [System.ComponentModel.DataAnnotations.MinLength(8, ErrorMessage = "Mínimo 8 caracteres")]
        [System.ComponentModel.DataAnnotations.RegularExpression(@"^(?=.*[a-z])(?=.*[A-Z])(?=.*\d)(?=.*[^\da-zA-Z]).{8,}$", ErrorMessage = "Debe tener mayúscula, minúscula, número y símbolo")]
        public string NewPassword { get; set; } = string.Empty;

        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "Confirma la contraseña")]
        [System.ComponentModel.DataAnnotations.Compare(nameof(NewPassword), ErrorMessage = "Las contraseñas no coinciden")]
        public string ConfirmPassword { get; set; } = string.Empty;
    }
}
