@page "/reset-password"
@layout EmptyLayout
@using ERP.Web.Services
@inject AuthService AuthService
@inject NavigationManager Navigation
@inject IJSRuntime JS

<div class="min-h-screen w-full flex items-center justify-center bg-[#020617] p-6">
    <div class="w-full max-w-md bg-[#0f172a] rounded-3xl shadow-2xl border border-slate-800/50 p-8">
        <div class="flex flex-col items-center mb-8">
            <div class="w-14 h-14 bg-emerald-600 rounded-2xl flex items-center justify-center text-white text-2xl font-black shadow-xl ring-1 ring-white/20"><i class="bi bi-shield-lock"></i></div>
            <h1 class="text-xl font-black text-white tracking-tight uppercase mt-4">Nueva contraseña</h1>
            <p class="text-slate-400 text-xs text-center mt-2">Introduce el token recibido y tu nueva contraseña (mín. 8 caracteres).</p>
        </div>

        <div class="space-y-4">
            <div>
                <label class="block text-[10px] font-black text-slate-500 uppercase tracking-widest mb-1 ml-1">Correo</label>
                <input @bind="email" placeholder="usuario@empresa.com" class="w-full bg-slate-900/50 border border-slate-800 text-white px-4 py-3 rounded-xl focus:ring-2 focus:ring-blue-500 outline-none placeholder:text-slate-600" />
            </div>
            <div>
                <label class="block text-[10px] font-black text-slate-500 uppercase tracking-widest mb-1 ml-1">Token</label>
                <textarea @bind="token" rows="3" placeholder="Pega aquí el token recibido por email" class="w-full bg-slate-900/50 border border-slate-800 text-white px-4 py-3 rounded-xl focus:ring-2 focus:ring-blue-500 outline-none placeholder:text-slate-600 text-xs break-all"></textarea>
            </div>
            <div>
                <label class="block text-[10px] font-black text-slate-500 uppercase tracking-widest mb-1 ml-1">Nueva contraseña</label>
                <input @bind="newPassword" type="password" placeholder="••••••••" class="w-full bg-slate-900/50 border border-slate-800 text-white px-4 py-3 rounded-xl focus:ring-2 focus:ring-blue-500 outline-none" />
            </div>
            <div>
                <label class="block text-[10px] font-black text-slate-500 uppercase tracking-widest mb-1 ml-1">Confirmar contraseña</label>
                <input @bind="confirmPassword" type="password" placeholder="••••••••" class="w-full bg-slate-900/50 border border-slate-800 text-white px-4 py-3 rounded-xl focus:ring-2 focus:ring-blue-500 outline-none" />
            </div>

            @if (!string.IsNullOrEmpty(mensaje))
            {
                <div class="@(ok ? "bg-emerald-500/10 border-emerald-500/20 text-emerald-400" : "bg-rose-500/10 border-rose-500/20 text-rose-400") border text-xs p-3 rounded-xl">@mensaje</div>
            }

            <button @onclick="Restablecer" disabled="@enviando"
                    class="w-full bg-emerald-600 hover:bg-emerald-500 disabled:bg-slate-700 text-white font-black text-[11px] uppercase tracking-widest py-4 rounded-xl shadow-lg flex items-center justify-center gap-2">
                @if (enviando) { <span class="w-4 h-4 border-2 border-white/30 border-t-white rounded-full animate-spin"></span> <span>Guardando...</span> }
                else { <span>Restablecer contraseña</span> <i class="bi bi-check-lg"></i> }
            </button>

            <div class="text-center">
                <a href="login" class="text-[11px] font-bold text-slate-400 hover:text-white">← Volver a login</a>
            </div>
        </div>
    </div>
</div>

@code {
    private string email = "";
    private string token = "";
    private string newPassword = "";
    private string confirmPassword = "";
    private bool enviando = false;
    private string? mensaje;
    private bool ok = false;

    protected override void OnInitialized()
    {
        var uri = Navigation.ToAbsoluteUri(Navigation.Uri);
        var q = uri.Query.TrimStart('?');
        if (!string.IsNullOrEmpty(q))
        {
            foreach (var pair in q.Split('&', StringSplitOptions.RemoveEmptyEntries))
            {
                var kv = pair.Split('=', 2);
                var key = System.Net.WebUtility.UrlDecode(kv[0]);
                var val = kv.Length > 1 ? System.Net.WebUtility.UrlDecode(kv[1]) : "";
                if (key == "email") email = val;
                else if (key == "token") token = val;
            }
        }
    }

    private async Task Restablecer()
    {
        if (string.IsNullOrWhiteSpace(email) || string.IsNullOrWhiteSpace(token) || string.IsNullOrWhiteSpace(newPassword))
        { mensaje = "Completa todos los campos"; ok = false; return; }
        if (newPassword != confirmPassword) { mensaje = "Las contraseñas no coinciden"; ok = false; return; }
        if (newPassword.Length < 8) { mensaje = "Mínimo 8 caracteres"; ok = false; return; }
        enviando = true; mensaje = null;
        var (okResp, msg) = await AuthService.ResetPassword(email.Trim(), token.Trim(), newPassword, confirmPassword);
        ok = okResp;
        mensaje = msg;
        enviando = false;
        if (okResp)
        {
            await Task.Delay(1200);
            Navigation.NavigateTo("login");
        }
    }
}
