@page "/nominas"
@using ERP.Domain.Entities
@using ERP.Domain.Entities.Bancario
@using ERP.Web.Services
@using ERP.Services
@inject EmpleadoService EmpleadoService
@inject NotificationService Notification
@inject NavigationManager Nav
<h3>Nóminas - SLD SEPA 2026</h3>

<div class="row">
    <div class="col-12 col-md-3">
        <div class="card">
            <div class="card-header">
                <h5>Datos Empleado</h5>
            </div>
            <div class="card-body">
                <select class="form-control" @bind="empleadoId">
                    <option value="">-- Seleccionar empleado --</option>
                    @foreach (var emp in Empleados)
                    {
                        <option value="@emp.Id">@emp.NombreCompleto (@(emp.CCC.Length >= 4 ? emp.CCC.Substring(0,4) : emp.CCC)...)</option>
                    }
                </select>
            </div>
        </div>
    </div>

    <div class="col-12 col-md-3">
        <div class="card">
            <div class="card-header">
                <h5>Desglose Cotización</h5>
            </div>
            <div class="card-body">
                <table class="table table-sm">
                    <tr><td>Base CC (Comunes)</td><td>@BaseCC €</td></tr>
                    <tr><td>Base AT (Accidentes Trabajo)</td><td>@BaseAT €</td></tr>
                    <tr><td>Base Horas Extra</td><td>@BaseHorasExtra €</td></tr>
                    <tr class="table-info"><td><strong>Cuota SG Social Trab.</strong></td><td><strong>@CuotaSGSocial €</strong></td></tr>
                    <tr class="table-danger"><td><strong>Retención IRPF</strong></td><td><strong>@RetencionIRPF €</strong></td></tr>
                </table>
            </div>
        </div>
    </div>

    <div class="col-12 col-md-3">
        <div class="card">
            <div class="card-header">
                <h5>Pagas Extra</h5>
            </div>
            <div class="card-body">
                <table class="table table-sm">
                    <tr><td>Paga Extra 1 (Junio)</td><td>@PagaExtra1 €</td></tr>
                    <tr><td>Paga Extra 2 (Diciembre)</td><td>@PagaExtra2 €</td></tr>
                    <tr class="table-success"><td><strong>Total Pagas Extra</strong></td><td><strong>@TotalPagasExtra €</strong></td></tr>
                </table>
            </div>
        </div>
    </div>

    <div class="col-12 col-md-3">
        <div class="card">
            <div class="card-header">
                <h5>Remesa SEPA</h5>
            </div>
            <div class="card-body">
                <select class="form-control" @bind="remesaId">
                    <option value="">-- Seleccionar remesa --</option>
                    @foreach (var r in RemesasSEPA)
                    {
                        <option value="@r.Id">Remesa @r.Referencia - @r.FechaCreacion.ToString("dd/MM")</option>
                    }
                </select>
                <br>
                <button class="btn btn-link text-primary w-100 small" @onclick="GenerarSEPA">
                    <span class="oi oi-download"></span> Generar XML SEPA
                </button>
            </div>
        </div>
    </div>
</div>

<div class="row mt-4">
    <div class="col-12">
        <div class="card">
            <div class="card-header">
                <h5>Listado Nóminas (@lstNominas.Count)</h5>
            </div>
            <div class="card-body p-0" style="height: 500px; overflow-y: auto;">
                <table class="table table-sm mb-0">
                    <thead>
                        <tr>
                            <th>Empleado</th>
                            <th>Periodo</th>
                            <th class="text-end">Base</th>
                            <th class="text-end">IRPF</th>
                            <th class="text-end">Cuota SG</th>
                            <th class="text-end">Pagas Extra</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var n in lstNominas)
                        {
                            <tr>
                                <td>@(n.Empleado?.NombreCompleto ?? "-")</td>
                                <td>@n.Mes.ToString("00")/@n.Anio</td>
                                <td class="text-end">@n.BaseTotal.ToString("N2") €</td>
                                <td class="text-end">@n.RetencionIRPF.ToString("N2") €</td>
                                <td class="text-end">@((n.CuotaSegSocialTrabajadorTotal != 0 ? n.CuotaSegSocialTrabajadorTotal : n.CuotaSegSocialTrabajador).ToString("N2")) €</td>
                                <td class="text-end">@((n.ImportePagasExtra != 0 ? n.ImportePagasExtra : n.PagasExtraProrrateadas).ToString("N2")) €</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@code {
    private int? empleadoId;
    private List<Empleado> Empleados = new();
    private List<Nomina> lstNominas = new();

    decimal BaseCC => 1200m;
    decimal BaseAT => 50m;
    decimal BaseHorasExtra => 80m;
    decimal CuotaSGSocial => Math.Round((BaseCC + BaseAT + BaseHorasExtra) * 28.3m / 100m, 2);
    decimal RetencionIRPF => Math.Round(CuotaSGSocial * 15m / 100m, 2);

    decimal PagaExtra1 => Math.Round(BaseCC * 20m / 100m, 2);
    decimal PagaExtra2 => Math.Round(BaseCC * 15m / 100m, 2);
    decimal TotalPagasExtra => PagaExtra1 + PagaExtra2;

    private int? remesaId;
    private List<RemesaSEPA> RemesasSEPA = new();

    protected override async Task OnInitializedAsync()
    {
        try
        {
            Empleados = await EmpleadoService.GetEmpleadosAsync();
        }
        catch { Empleados = new(); }

        // lstNominas se deja vacío en Web (sin acceso directo a NominaService backend).
        // Se cargará vía API cuando esté disponible. Por ahora muestra 0.
        lstNominas = new();
    }

    private async Task GenerarSEPA()
    {
        if (empleadoId == null || empleadoId == 0) { Notification.Error("Seleccione un empleado"); return; }
        // En Web no hay NominaService directo; se simula generación
        Notification.Success($"Archivo SEPA solicitado para empleado {empleadoId.Value} (pendiente integración API)");
        await Task.CompletedTask;
    }
}
