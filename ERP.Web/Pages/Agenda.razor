@page "/agenda"
@using Microsoft.AspNetCore.Components.Routing
@using System.Globalization
@using System.Net.Http.Json
@inject HttpClient Http
@inject NavigationManager Navigation

<div class="max-w-[1200px] mx-auto p-8 animate-in fade-in duration-500">

    @* --- CABECERA DE AGENDA --- *@
    <div class="flex justify-between items-end mb-8 border-b-2 border-slate-200 pb-6">
        <div>
            <h1 class="text-4xl font-black text-slate-900 uppercase tracking-tighter">Mi Agenda</h1>
            <p class="text-slate-500 font-bold italic">@FechaFormateada</p>
        </div>
        <div class="flex gap-2">
            <button @onclick="AbrirModalNueva" class="bg-blue-600 text-white px-6 py-2 rounded-xl font-black text-[10px] hover:bg-blue-700 transition shadow-lg shadow-blue-200 uppercase flex items-center gap-2">
                <i class="bi bi-plus-lg"></i> Nueva Tarea
            </button>
            <NavLink href="" class="bg-slate-200 text-slate-700 px-6 py-2 rounded-xl font-black text-[10px] no-underline uppercase hover:bg-slate-300 transition flex items-center gap-2">
                <i class="bi bi-arrow-left"></i> Escritorio
            </NavLink>
        </div>
    </div>

    @* --- FILTROS RÁPIDOS --- *@
    <div class="flex gap-4 mb-6">
        <button @onclick='() => filtroActual = "Todas"' 
                class="@(filtroActual == "Todas" ? "bg-slate-900 text-white shadow-lg shadow-slate-900/20" : "bg-white text-slate-500 border border-slate-300") px-5 py-1.5 rounded-full text-[10px] font-black uppercase transition-all">
            <i class="bi bi-list-task mr-1"></i> Todas
        </button>
        <button @onclick='() => filtroActual = "Pendientes"' 
                class="@(filtroActual == "Pendientes" ? "bg-orange-500 text-white shadow-lg shadow-orange-500/20" : "bg-white text-slate-500 border border-slate-300") px-5 py-1.5 rounded-full text-[10px] font-black uppercase transition-all">
            <i class="bi bi-clock-history mr-1"></i> Pendientes
        </button>
        <button @onclick='() => filtroActual = "Completadas"' 
                class="@(filtroActual == "Completadas" ? "bg-green-600 text-white shadow-lg shadow-green-600/20" : "bg-white text-slate-500 border border-slate-300") px-5 py-1.5 rounded-full text-[10px] font-black uppercase transition-all">
            <i class="bi bi-check-circle-fill mr-1"></i> Hechas
        </button>
    </div>

    @* --- TABLA DE TAREAS --- *@
    <div class="bg-white rounded-[2rem] shadow-xl border border-slate-100 overflow-hidden">
        <table class="w-full text-left border-collapse">
            <thead>
                <tr class="bg-slate-50 text-slate-400 text-[10px] font-black uppercase tracking-widest border-b border-slate-100">
                    <th class="p-5">Hora</th>
                    <th class="p-5">Tarea / Actividad</th>
                    <th class="p-5">Prioridad</th>
                    <th class="p-5">Estado</th>
                    <th class="p-5 text-right">Acciones</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-slate-100">
                @if (cargando)
                {
                    <tr class="text-center text-slate-500">
                        <td class="p-5" colspan="5">Cargando tareas...</td>
                    </tr>
                }
                else if (errorCarga)
                {
                    <tr class="text-center text-red-600">
                        <td class="p-5" colspan="5">Error al cargar las tareas. Por favor, recargue la página.</td>
                    </tr>
                }
                else
                {
                    @foreach (var tarea in TareasFiltradas)
                    {
                        var prioridadClass = tarea.Prioridad == "ALTA" 
                            ? "bg-rose-100 text-rose-700 px-3 py-1 rounded-lg text-[9px] font-black border border-rose-200" 
                            : tarea.Prioridad == "MEDIA" ? "bg-amber-100 text-amber-700 px-3 py-1 rounded-lg text-[9px] font-black border border-amber-200"
                            : "bg-slate-100 text-slate-500 px-3 py-1 rounded-lg text-[9px] font-black border border-slate-200";
                        
                        var estadoClass = tarea.Completada 
                            ? "bg-green-500 border-green-600 shadow-sm" 
                            : "bg-white border-slate-200 group-hover:border-blue-400";
                        
                        var estadoTexto = tarea.Completada ? "Completado" : "Marcar hecho";

                        <tr class="hover:bg-blue-50/30 transition-colors cursor-default group">
                            <td class="p-5 font-mono font-bold text-blue-600 text-sm">@tarea.Hora</td>
                            <td class="p-5">
                                <div class="font-black text-slate-800 uppercase text-sm @(tarea.Completada ? "line-through opacity-40" : "")">@tarea.Titulo</div>
                                <div class="text-[11px] text-slate-400 italic font-medium">@tarea.Descripcion</div>
                            </td>
                            <td class="p-5">
                                <span class="@prioridadClass">@tarea.Prioridad</span>
                            </td>
                            <td class="p-5">
                                <button @onclick="() => CambiarEstadoTarea(tarea)" class="flex items-center gap-2 group">
                                    <div class="w-4 h-4 rounded-md border-2 transition-all flex items-center justify-center flex @estadoClass">
                                        @if (tarea.Completada)
                                        {
                                            <i class="bi bi-check text-white text-xs"></i>
                                        }
                                    </div>
                                    <span class="text-[10px] font-black text-slate-500 uppercase group-hover:text-slate-800">@estadoTexto</span>
                                </button>
                            </td>
                            <td class="p-5 text-right opacity-0 group-hover:opacity-100 transition-opacity">
                                <button @onclick="() => EditarTarea(tarea)" class="text-blue-600 p-2 hover:bg-blue-100 rounded-lg transition-colors">
                                    <i class="bi bi-pencil-square"></i>
                                </button>
                                <button @onclick="() => EliminarTarea(tarea)" class="text-rose-400 p-2 hover:bg-rose-100 rounded-lg transition-colors ml-1">
                                    <i class="bi bi-trash3-fill"></i>
                                </button>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
        
        @if (!cargando && !errorCarga && !TareasFiltradas.Any())
        {
            <div class="p-16 text-center">
                <i class="bi bi-clipboard-x text-5xl text-slate-200 mb-4 block"></i>
                <p class="text-slate-400 italic text-sm font-medium">No hay tareas registradas en esta sección.</p>
            </div>
        }
    </div>

    @* --- MODAL NUEVA/EDITAR TAREA --- *@
    @if (mostrarModal)
    {
        <div class="fixed inset-0 bg-slate-900/60 backdrop-blur-md z-50 flex items-center justify-center p-4">
            <div class="bg-white rounded-3xl shadow-2xl w-full max-w-lg overflow-hidden animate-in zoom-in duration-200">
                <div class="p-8 border-b border-slate-100 flex justify-between items-center bg-slate-50/50">
                    <div>
                        <h2 class="text-xl font-black uppercase tracking-tighter">@(editandoId == 0 ? "Nueva Cita / Tarea" : "Editar Tarea")</h2>
                        <p class="text-[10px] font-bold text-slate-400 uppercase tracking-widest">Agenda personal</p>
                    </div>
                    <button @onclick="CerrarModal" class="h-10 w-10 flex items-center justify-center border border-slate-200 rounded-full font-black text-slate-400 hover:bg-white hover:text-red-500 transition">✕</button>
                </div>
                <div class="p-8 space-y-5">
                    <div class="grid grid-cols-2 gap-4">
                        <div>
                            <label class="text-[10px] font-black uppercase text-slate-400 mb-2 block">Hora</label>
                            <input @bind="tareaEdicion.Hora" type="text" placeholder="HH:mm" class="w-full p-3 bg-slate-50 border border-slate-200 rounded-xl focus:bg-white focus:ring-2 focus:ring-blue-500 outline-none" />
                        </div>
                        <div>
                            <label class="text-[10px] font-black uppercase text-slate-400 mb-2 block">Prioridad</label>
                            <select @bind="tareaEdicion.Prioridad" class="w-full p-3 bg-slate-50 border border-slate-200 rounded-xl outline-none">
                                <option value="BAJA">BAJA</option>
                                <option value="MEDIA">MEDIA</option>
                                <option value="ALTA">ALTA</option>
                            </select>
                        </div>
                    </div>
                    <div>
                        <label class="text-[10px] font-black uppercase text-slate-400 mb-2 block">Título *</label>
                        <input @bind="tareaEdicion.Titulo" placeholder="Ej. Llamar a cliente..." class="w-full p-3 bg-slate-50 border border-slate-200 rounded-xl focus:bg-white focus:ring-2 focus:ring-blue-500 outline-none font-bold uppercase text-sm" />
                    </div>
                    <div>
                        <label class="text-[10px] font-black uppercase text-slate-400 mb-2 block">Descripción</label>
                        <textarea @bind="tareaEdicion.Descripcion" rows="3" placeholder="Detalles adicionales..." class="w-full p-3 bg-slate-50 border border-slate-200 rounded-xl focus:bg-white outline-none text-sm"></textarea>
                    </div>
                    @if (!string.IsNullOrEmpty(modalError))
                    {
                        <div class="p-3 bg-rose-50 border border-rose-200 rounded-xl text-rose-700 text-xs font-bold">@modalError</div>
                    }
                    <div class="flex gap-3 pt-2">
                        <button @onclick="GuardarTarea" disabled="@guardando" class="flex-1 bg-blue-600 text-white py-4 rounded-2xl font-black text-xs uppercase tracking-widest hover:bg-slate-900 transition-all shadow-xl disabled:opacity-50">
                            @(guardando ? "Guardando..." : (editandoId == 0 ? "Crear Tarea" : "Guardar Cambios"))
                        </button>
                        <button @onclick="CerrarModal" class="px-8 bg-slate-100 text-slate-500 rounded-2xl font-black text-xs uppercase hover:bg-slate-200 transition">Cancelar</button>
                    </div>
                </div>
            </div>
        </div>
    }

</div>

@code {
    public class Tarea
    {
        public int Id { get; set; }
        public string Hora { get; set; } = string.Empty;
        public string Titulo { get; set; } = string.Empty;
        public string Descripcion { get; set; } = string.Empty;
        public string Prioridad { get; set; } = "MEDIA";
        public bool Completada { get; set; }
    }

    private List<Tarea> tareas = new();
    private string filtroActual = "Todas";
    private bool cargando = true;
    private bool errorCarga = false;

    // modal state
    private bool mostrarModal = false;
    private bool guardando = false;
    private int editandoId = 0;
    private Tarea tareaEdicion = new();
    private string modalError = "";

    private string FechaFormateada => DateTime.Now.ToString("dddd, dd 'de' MMMM 'de' yyyy", new CultureInfo("es-ES"));

    private IEnumerable<Tarea> TareasFiltradas => filtroActual switch
    {
        "Pendientes" => tareas.Where(t => !t.Completada),
        "Completadas" => tareas.Where(t => t.Completada),
        _ => tareas
    };

    protected override async Task OnInitializedAsync()
    {
        await CargarTareas();
        // Si viene de Home +Cita (agenda?nueva=1) abre directamente el formulario
        var uri = Navigation.ToAbsoluteUri(Navigation.Uri);
        if (uri.Query.Contains("nueva=1"))
        {
            AbrirModalNueva();
        }
    }

    private async Task CargarTareas()
    {
        try
        {
            cargando = true;
            errorCarga = false;
            var resultado = await Http.GetFromJsonAsync<List<Tarea>>("api/tareas");
            if (resultado != null)
            {
                tareas = resultado;
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error al cargar tareas: {ex.Message}");
            errorCarga = true;
        }
        finally
        {
            cargando = false;
        }
    }

    private void AbrirModalNueva()
    {
        editandoId = 0;
        tareaEdicion = new Tarea { Hora = DateTime.Now.ToString("HH:mm"), Prioridad = "MEDIA" };
        modalError = "";
        mostrarModal = true;
    }

    private void EditarTarea(Tarea tarea)
    {
        editandoId = tarea.Id;
        tareaEdicion = new Tarea { Id = tarea.Id, Hora = tarea.Hora, Titulo = tarea.Titulo, Descripcion = tarea.Descripcion, Prioridad = tarea.Prioridad, Completada = tarea.Completada };
        modalError = "";
        mostrarModal = true;
    }

    private void CerrarModal()
    {
        mostrarModal = false;
        // limpiar query ?nueva=1 para no reabrir al recargar
        var uri = Navigation.ToAbsoluteUri(Navigation.Uri);
        if (uri.Query.Contains("nueva"))
        {
            Navigation.NavigateTo("/agenda", replace: true);
        }
    }

    private async Task GuardarTarea()
    {
        if (string.IsNullOrWhiteSpace(tareaEdicion.Titulo))
        {
            modalError = "El título es obligatorio.";
            return;
        }
        guardando = true;
        modalError = "";
        try
        {
            HttpResponseMessage resp;
            if (editandoId == 0)
                resp = await Http.PostAsJsonAsync("api/tareas", tareaEdicion);
            else
                resp = await Http.PutAsJsonAsync($"api/tareas/{editandoId}", tareaEdicion);

            if (resp.IsSuccessStatusCode)
            {
                await CargarTareas();
                CerrarModal();
            }
            else
            {
                var txt = await resp.Content.ReadAsStringAsync();
                modalError = string.IsNullOrWhiteSpace(txt) ? "Error al guardar" : txt;
            }
        }
        catch (Exception ex)
        {
            modalError = $"Error de conexión: {ex.Message}";
        }
        finally { guardando = false; }
    }

    private async Task CambiarEstadoTarea(Tarea tarea)
    {
        var prev = tarea.Completada;
        tarea.Completada = !tarea.Completada;
        try
        {
            var resp = await Http.PatchAsync($"api/tareas/{tarea.Id}/toggle", null);
            if (!resp.IsSuccessStatusCode)
            {
                // fallback a PUT si el PATCH no existe
                await Http.PutAsJsonAsync($"api/tareas/{tarea.Id}", tarea);
            }
        }
        catch
        {
            tarea.Completada = prev;
        }
    }

    private async Task EliminarTarea(Tarea tarea)
    {
        try
        {
            var resp = await Http.DeleteAsync($"api/tareas/{tarea.Id}");
            if (resp.IsSuccessStatusCode)
                tareas.Remove(tarea);
            else
                await CargarTareas();
        }
        catch { await CargarTareas(); }
    }
}
