@page "/ventas/editor/{Id:int?}"
@using ERP.Domain
@using ERP.Domain.Entities
@inject HttpClient Http
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject NotificationService Notify

<div class="max-w-2xl mx-auto p-6 animate-in fade-in duration-500">

    <div class="bg-slate-950/30 backdrop-blur-xl rounded-2xl p-6 border border-slate-700/30 mb-6">
        <div class="flex flex-col sm:flex-row gap-4 mb-4">
            <NavLink class="flex-1 bg-slate-800/50 rounded-xl px-4 py-3 text-sm font-black text-slate-300 uppercase tracking-widest"
                     href="ventas/facturas" Match="NavLinkMatch.Prefix"
                     ActiveClass="bg-slate-800 text-slate-100">
                Listado de Documentos
            </NavLink>
            <button @onclick="NuevoDocumento" class="bg-slate-800 rounded-xl px-4 py-3 text-sm font-black uppercase tracking-widest hover:bg-slate-700 transition-all">
                <i class="bi bi-plus-lg mr-2"></i> Nuevo Documento
            </button>
        </div>
        <div class="grid grid-cols-2 gap-4">
            <div>
                <label class="text-[9px] font-black text-slate-400 uppercase mb-1 tracking-widest">Tipo</label>
                <select @onchange="cambiarTipo" class="w-full p-3 bg-slate-800 border border-slate-600 rounded-xl text-white focus:ring-2 focus:ring-blue-500/20 focus:border-transparent transition">
                    <option value="">-- Seleccionar --</option>
                    <option value="Presupuesto">Presupuesto</option>
                    <option value="Pedido">Pedido</option>
                    <option value="Albaran">Albarán</option>
                    <option value="Factura">Factura</option>
                    <option value="FacturaRectificativa">Rectificativa</option>
                </select>
            </div>
            <div>
                <label class="text-[9px] font-black text-slate-400 uppercase mb-1 tracking-widest">Número</label>
                <InputText class="w-full p-3 bg-slate-800 border border-slate-600 rounded-xl text-white focus:ring-2 focus:ring-blue-500/20 focus:border-transparent transition" />
            </div>
            <div>
                <label class="text-[9px] font-black text-slate-400 uppercase mb-1 tracking-widest">Fecha</label>
                <InputText class="w-full p-3 bg-slate-800 border border-slate-600 rounded-xl text-white focus:ring-2 focus:ring-blue-500/20 focus:border-transparent transition" placeholder="AAAA-MM-DD" />
            </div>
        </div>
    </div>

    <div class="bg-slate-950/30 backdrop-blur-xl rounded-2xl p-6 border border-slate-700/30 mb-6">
        <span class="text-[9px] font-black text-slate-300 uppercase tracking-widest">Lineas (@(Documento.Lineas.Count))</span>
        @if (Documento.Lineas.Any())
        {
            <table class="w-full text-sm"><thead class="bg-slate-800/50"><tr><th class="p-3">Artículo</th><th class="p-3 text-center">Cantidad</th><th class="p-3 text-end">Precio</th><th class="p-3 text-end">Subtotal</th></tr></thead><tbody><tr><td class="p-3"></td><td class="p-3 text-center"><input type="number" min="1" class="w-full p-2 bg-slate-800 border border-slate-600 rounded text-white" /></td><td class="p-3 text-end"><input type="number" step="0.01" min="0" class="w-full p-2 bg-slate-800 border border-slate-600 rounded text-white" /></td><td class="p-3 text-end"><span>0,00€</span></td></tr></tbody></table>
        }
        else { <div class="p-8 text-center text-slate-500"><i class="bi bi-grid text-3xl mb-3"></i><p>No hay líneas.</p></div> }
    </div>

    <div class="bg-slate-950/30 backdrop-blur-xl rounded-2xl p-6 border border-slate-700/30">
        <div class="grid grid-cols-2 gap-4 flex flex-wrap">
            @if (Documento.Estado == EstadoDocumento.Borrador && Documento.Tipo != 0)
            {
                <button class="col-span-2 bg-slate-900 text-white py-4 rounded-2xl font-black text-xs uppercase tracking-widest hover:bg-blue-600 transition-all shadow-xl active:scale-95">
                    <i class="bi bi-save mr-2"></i> Guardar Como Borrador
                </button>
            }
            @if (Documento.Estado == EstadoDocumento.Borrador && Documento.Tipo != 0)
            {
                <button class="col-span-2 bg-blue-600 text-white py-4 rounded-2xl font-black text-xs uppercase tracking-widest hover:bg-blue-700 transition-all shadow-xl active:scale-95">
                    <i class="bi bi-arrow-up-circle mr-2"></i> Convertir y Continuar
                </button>
            }
            @if (Documento.Estado == EstadoDocumento.Emitido)
            {
                <button class="col-span-2 bg-emerald-600 text-white py-4 rounded-2xl font-black text-xs uppercase tracking-widest hover:bg-emerald-700 transition-all shadow-xl active:scale-95">
                    <i class="bi bi-file-pdf mr-2"></i> Descargar PDF
                </button>
            }
            @if (Documento.Estado == EstadoDocumento.Emitido)
            {
                <button class="col-span-2 bg-rose-600 text-white py-4 rounded-2xl font-black text-xs uppercase tracking-widest hover:bg-rose-600 transition-all shadow-xl active:scale-95">
                    <i class="bi bi-x-circle mr-2"></i> Anular Documento
                </button>
            }
        </div>
    </div>
</div>

@code {
    [Parameter] public int? Id { get; set; }
    public DocumentoComercial Documento = new();
    private void cambiarTipo() { }
    private void cambiarEstado() { }

    private void NuevoDocumento() { Documento = new(); Nav.NavigateTo("/ventas/editor"); }

    protected override void OnInitialized()
    {
        if (Id.HasValue)
        {
            var task = Http.GetFromJsonAsync<DocumentoComercial>($"api/CicloFacturacion/{Id}");
            task.Wait();
            Documento = task.Result ?? new DocumentoComercial();
        }
    }
}