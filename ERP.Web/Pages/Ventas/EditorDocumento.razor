@page "/ventas/editor/{Id:int?}"
@page "/ventas/detalle-factura/{Id:int?}"
@using ERP.Domain.Entities
@inject HttpClient Http
@inject NavigationManager Nav
@inject IJSRuntime JS

<div class="max-w-3xl mx-auto p-6 animate-in fade-in duration-500">

    <div class="flex items-center gap-3 mb-6">
        <button @onclick='() => Nav.NavigateTo("/ventas/presupuestos")' class="h-10 w-10 rounded-xl bg-slate-800 text-white flex items-center justify-center hover:bg-slate-700"><i class="bi bi-arrow-left"></i></button>
        <div>
            <h1 class="text-2xl font-black text-white uppercase tracking-tighter">Detalle Documento</h1>
            <p class="text-slate-500 text-xs font-bold uppercase tracking-widest">@(Documento.NumeroDocumento ?? "—") · @Documento.Tipo · @Documento.Fecha.ToString("dd/MM/yyyy")</p>
        </div>
    </div>

    @if (cargando)
    {
        <div class="p-10 text-center text-slate-500">Cargando documento...</div>
    }
    else if (Documento.Id == 0 && Id.HasValue)
    {
        <div class="p-10 text-center text-rose-400">Documento no encontrado</div>
    }
    else
    {
        <div class="bg-slate-900 rounded-2xl p-6 border border-slate-800 mb-6">
            <div class="grid grid-cols-2 gap-4">
                <div>
                    <label class="text-[9px] font-black text-slate-400 uppercase mb-1 block">Tipo</label>
                    <div class="w-full p-3 bg-slate-800 border border-slate-700 rounded-xl text-white">@Documento.Tipo</div>
                </div>
                <div>
                    <label class="text-[9px] font-black text-slate-400 uppercase mb-1 block">Número</label>
                    <div class="w-full p-3 bg-slate-800 border border-slate-700 rounded-xl text-white font-mono">@Documento.NumeroDocumento</div>
                </div>
                <div>
                    <label class="text-[9px] font-black text-slate-400 uppercase mb-1 block">Fecha</label>
                    <div class="w-full p-3 bg-slate-800 border border-slate-700 rounded-xl text-white">@Documento.Fecha.ToString("dd/MM/yyyy")</div>
                </div>
                <div>
                    <label class="text-[9px] font-black text-slate-400 uppercase mb-1 block">Cliente</label>
                    <div class="w-full p-3 bg-slate-800 border border-slate-700 rounded-xl text-white">@(Documento.Cliente?.RazonSocial ?? $"ID {Documento.ClienteId}")</div>
                </div>
                <div>
                    <label class="text-[9px] font-black text-slate-400 uppercase mb-1 block">Estado</label>
                    <div class="w-full p-3 bg-slate-800 border border-slate-700 rounded-xl text-white">@Documento.Estado</div>
                </div>
                <div>
                    <label class="text-[9px] font-black text-slate-400 uppercase mb-1 block">Total</label>
                    <div class="w-full p-3 bg-slate-800 border border-slate-700 rounded-xl text-emerald-400 font-black">@Documento.Total.ToString("N2") €</div>
                </div>
            </div>
        </div>

        <div class="bg-slate-900 rounded-2xl p-6 border border-slate-800 mb-6">
            <span class="text-[9px] font-black text-slate-300 uppercase tracking-widest">Líneas (@Documento.Lineas.Count)</span>
            @if (Documento.Lineas.Any())
            {
                <table class="w-full text-sm mt-3">
                    <thead class="bg-slate-800/50 text-slate-400 text-[10px] uppercase">
                        <tr><th class="p-3 text-left">Artículo</th><th class="p-3 text-center">Cant.</th><th class="p-3 text-end">Precio</th><th class="p-3 text-end">Subtotal</th></tr>
                    </thead>
                    <tbody class="divide-y divide-slate-800">
                        @foreach (var l in Documento.Lineas)
                        {
                            <tr class="text-white">
                                <td class="p-3">@l.DescripcionArticulo</td>
                                <td class="p-3 text-center">@l.Cantidad</td>
                                <td class="p-3 text-end">@l.PrecioUnitario.ToString("N2") €</td>
                                <td class="p-3 text-end font-bold">@l.Subtotal.ToString("N2") €</td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            else { <div class="p-8 text-center text-slate-500"><i class="bi bi-grid text-3xl mb-3 block"></i><p>No hay líneas.</p></div> }
        </div>

        <div class="bg-slate-900 rounded-2xl p-6 border border-slate-800">
            <div class="grid grid-cols-1 gap-3">
                @if (Documento.Tipo == TipoDocumento.Presupuesto && Documento.Estado != EstadoDocumento.Emitido)
                {
                    <button @onclick="ConvertirAAlbaran" class="w-full bg-indigo-600 text-white py-4 rounded-2xl font-black text-xs uppercase tracking-widest hover:bg-indigo-700 transition shadow-xl"><i class="bi bi-box-seam mr-2"></i> Convertir a Albarán</button>
                }
                @if (Documento.Tipo == TipoDocumento.Factura || Documento.Tipo == TipoDocumento.FacturaRectificativa)
                {
                    <button @onclick="DescargarPdf" class="w-full bg-emerald-600 text-white py-4 rounded-2xl font-black text-xs uppercase tracking-widest hover:bg-emerald-700 transition shadow-xl"><i class="bi bi-file-earmark-pdf mr-2"></i> Descargar PDF</button>
                }
                @if (Documento.Estado == EstadoDocumento.Borrador)
                {
                    <button @onclick="Eliminar" class="w-full bg-rose-600 text-white py-3 rounded-xl font-black text-xs uppercase">Eliminar</button>
                }
                <button @onclick="Volver" class="w-full bg-slate-800 text-white py-3 rounded-xl font-black text-xs uppercase">Volver</button>
            </div>
        </div>
    }
</div>

@code {
    [Parameter] public int? Id { get; set; }
    public DocumentoComercial Documento = new();
    private bool cargando = false;

    protected override async Task OnInitializedAsync()
    {
        if (Id.HasValue)
        {
            cargando = true;
            try { var doc = await Http.GetFromJsonAsync<DocumentoComercial>($"api/CicloFacturacion/{Id.Value}"); if (doc != null) Documento = doc; }
            catch (Exception ex) { Console.WriteLine(ex.Message); }
            finally { cargando = false; }
        }
    }

    private async Task ConvertirAAlbaran()
    {
        if (!await JS.InvokeAsync<bool>("confirm", "¿Convertir presupuesto a albarán?")) return;
        var res = await Http.PostAsync($"api/CicloFacturacion/{Documento.Id}/convertir?nuevoTipo={TipoDocumento.Albaran}", null);
        if (res.IsSuccessStatusCode) Nav.NavigateTo("/ventas/albaranes");
        else { var msg = await res.Content.ReadAsStringAsync(); await JS.InvokeVoidAsync("alert", msg); }
    }

    private async Task Eliminar()
    {
        if (!await JS.InvokeAsync<bool>("confirm", "¿Eliminar documento?")) return;
        var res = await Http.DeleteAsync($"api/CicloFacturacion/albaran/{Documento.Id}");
        if (res.IsSuccessStatusCode) Volver();
        else { var msg = await res.Content.ReadAsStringAsync(); await JS.InvokeVoidAsync("alert", msg); }
    }

    private async Task DescargarPdf()
    {
        try
        {
            var resp = await Http.GetAsync($"api/facturacion/descargar-pdf/{Documento.Id}");
            if (resp.IsSuccessStatusCode)
            {
                var bytes = await resp.Content.ReadAsByteArrayAsync();
                await JS.InvokeVoidAsync("downloadFile", $"{Documento.Tipo}_{Documento.NumeroDocumento}.pdf", Convert.ToBase64String(bytes));
            }
            else { var msg = await resp.Content.ReadAsStringAsync(); await JS.InvokeVoidAsync("alert", msg); }
        }
        catch (Exception ex) { await JS.InvokeVoidAsync("alert", ex.Message); }
    }

    private void Volver()
    {
        var dest = Documento.Tipo switch
        {
            TipoDocumento.Factura or TipoDocumento.FacturaRectificativa => "/ventas/facturas",
            TipoDocumento.Albaran => "/ventas/albaranes",
            _ => "/ventas/presupuestos"
        };
        Nav.NavigateTo(dest);
    }
}
