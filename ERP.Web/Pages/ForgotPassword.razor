@page "/forgot-password"
@layout EmptyLayout
@using ERP.Web.Services
@inject AuthService AuthService
@inject NavigationManager NavigationManager
@inject NotificationService NotificationService

<div class="min-h-screen w-full flex items-center justify-center bg-[#020617] p-6">
    <div class="w-full max-w-md bg-[#0f172a] rounded-3xl shadow-2xl border border-slate-800/50 p-8">
        <div class="flex flex-col items-center mb-8">
            <div class="w-16 h-16 bg-blue-600 rounded-2xl flex items-center justify-center text-white text-2xl font-black shadow-xl shadow-blue-500/20 mb-4 ring-1 ring-white/20">
                <i class="bi bi-envelope-lock"></i>
            </div>
            <h1 class="text-xl font-black text-white tracking-tight uppercase">Recuperar <span class="text-blue-500">contraseña</span></h1>
            <p class="text-slate-500 text-[11px] font-bold tracking-wide mt-2 text-center">"¿Has olvidado tu contraseña?" — te enviamos un correo para cambiarla</p>
        </div>

        @if (enviado)
        {
            <div class="bg-emerald-500/10 border border-emerald-500/20 text-emerald-400 text-[12px] p-4 rounded-xl text-center">
                <i class="bi bi-check-circle-fill text-lg block mb-2"></i>
                Si el correo existe en el sistema, recibirás un email con instrucciones para restablecer tu contraseña.<br/>
                <span class="text-[11px] text-slate-400">Revisa también la carpeta de spam.</span>
            </div>
            <button @onclick='() => NavigationManager.NavigateTo("login")' class="mt-6 w-full bg-slate-800 hover:bg-slate-700 text-white font-black text-[11px] uppercase tracking-[0.2em] py-3 rounded-xl transition">Volver al login</button>
        }
        else
        {
            <EditForm Model="@model" OnValidSubmit="HandleForgot">
                <DataAnnotationsValidator />
                <div class="space-y-5">
                    <div>
                        <label class="block text-[10px] font-black text-slate-500 uppercase tracking-widest mb-2 ml-1">Correo electrónico</label>
                        <div class="relative">
                            <i class="bi bi-envelope absolute left-4 top-1/2 -translate-y-1/2 text-slate-500"></i>
                            <InputText @bind-Value="model.Email" class="w-full bg-slate-900/50 border border-slate-800 text-white pl-12 pr-4 py-3 rounded-xl focus:ring-2 focus:ring-blue-500 focus:border-transparent outline-none transition-all placeholder:text-slate-700" placeholder="usuario@empresa.com" />
                        </div>
                        <ValidationMessage For="@(() => model.Email)" class="text-red-500 text-[10px] mt-1 font-bold" />
                    </div>

                    @if (!string.IsNullOrEmpty(errorMessage))
                    {
                        <div class="bg-red-500/10 border border-red-500/20 text-red-500 text-[11px] p-3 rounded-xl">@errorMessage</div>
                    }

                    <button type="submit" disabled="@isSubmitting" class="w-full bg-blue-600 hover:bg-blue-500 disabled:bg-slate-800 text-white font-black text-[11px] uppercase tracking-[0.2em] py-4 rounded-xl shadow-lg shadow-blue-900/20 transition flex items-center justify-center gap-2">
                        @if (isSubmitting) { <div class="w-4 h-4 border-2 border-white/30 border-t-white rounded-full animate-spin"></div><span>Enviando...</span> } else { <span>Enviar correo de recuperación</span><i class="bi bi-send"></i> }
                    </button>

                    <div class="flex justify-between items-center text-[11px]">
                        <a href="login" class="text-slate-500 hover:text-white hover:underline">Volver al login</a>
                        <span class="text-slate-600">Recibirás un enlace válido 2h</span>
                    </div>
                </div>
            </EditForm>
        }

        <p class="mt-8 text-center text-slate-600 text-[10px]">&copy; 2026 ERP Industrial.</p>
    </div>
</div>

@code {
    private ForgotModel model = new();
    private bool isSubmitting = false;
    private bool enviado = false;
    private string? errorMessage;

    private async Task HandleForgot()
    {
        isSubmitting = true;
        errorMessage = null;
        try
        {
            var (ok, message) = await AuthService.ForgotPassword(model.Email);
            if (ok)
            {
                enviado = true;
                NotificationService.Success("Si el correo existe, recibirás instrucciones por email.");
            }
            else
            {
                errorMessage = "No se pudo procesar la solicitud. Inténtalo de nuevo.";
                NotificationService.Error(errorMessage);
            }
        }
        catch (Exception ex)
        {
            errorMessage = "Error de conexión con el servidor.";
            Console.WriteLine($"ForgotPassword error: {ex.Message}");
        }
        finally { isSubmitting = false; }
    }

    public class ForgotModel
    {
        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "El correo es obligatorio")]
        [System.ComponentModel.DataAnnotations.EmailAddress(ErrorMessage = "Formato de email inválido")]
        public string Email { get; set; } = string.Empty;
    }
}
