@page "/forgot-password"
@layout EmptyLayout
@using ERP.Web.Services
@inject AuthService AuthService
@inject NavigationManager Navigation
@inject IJSRuntime JS

<div class="min-h-screen w-full flex items-center justify-center bg-[#020617] p-6">
    <div class="w-full max-w-md bg-[#0f172a] rounded-3xl shadow-2xl border border-slate-800/50 p-8">
        <div class="flex flex-col items-center mb-8">
            <div class="w-14 h-14 bg-blue-600 rounded-2xl flex items-center justify-center text-white text-2xl font-black shadow-xl ring-1 ring-white/20">E</div>
            <h1 class="text-xl font-black text-white tracking-tight uppercase mt-4">Recuperar contraseña</h1>
            <p class="text-slate-400 text-xs text-center mt-2">Introduce tu correo y te enviaremos un enlace para restablecerla. Si el correo existe, recibirás instrucciones.</p>
        </div>

        <div class="space-y-5">
            <div>
                <label class="block text-[10px] font-black text-slate-500 uppercase tracking-widest mb-2 ml-1">Correo Electrónico</label>
                <div class="relative">
                    <i class="bi bi-envelope absolute left-4 top-1/2 -translate-y-1/2 text-slate-500"></i>
                    <input @bind="email" @bind:event="oninput" placeholder="usuario@empresa.com"
                           class="w-full bg-slate-900/50 border border-slate-800 text-white pl-12 pr-4 py-3 rounded-xl focus:ring-2 focus:ring-blue-500 outline-none placeholder:text-slate-600" />
                </div>
            </div>

            @if (!string.IsNullOrEmpty(mensaje))
            {
                <div class="@(ok ? "bg-emerald-500/10 border-emerald-500/20 text-emerald-400" : "bg-rose-500/10 border-rose-500/20 text-rose-400") border text-xs p-3 rounded-xl">@mensaje</div>
            }
            @if (!string.IsNullOrEmpty(devToken))
            {
                <div class="bg-amber-500/10 border border-amber-500/20 rounded-xl p-3">
                    <p class="text-amber-400 text-xs font-bold">Modo desarrollo — Token generado:</p>
                    <p class="text-amber-300 text-[10px] break-all mt-1">@devToken</p>
                    <button @onclick="IrAResetConToken" class="mt-3 w-full bg-amber-600 hover:bg-amber-500 text-white py-2 rounded-xl text-xs font-black uppercase">Ir a restablecer ahora</button>
                </div>
            }

            <button @onclick="Enviar" disabled="@enviando || string.IsNullOrWhiteSpace(email)"
                    class="w-full bg-blue-600 hover:bg-blue-500 disabled:bg-slate-700 text-white font-black text-[11px] uppercase tracking-widest py-4 rounded-xl shadow-lg flex items-center justify-center gap-2">
                @if (enviando) { <span class="w-4 h-4 border-2 border-white/30 border-t-white rounded-full animate-spin"></span> <span>Enviando...</span> }
                else { <span>Enviar enlace</span> <i class="bi bi-send"></i> }
            </button>

            <div class="flex justify-between text-[11px] font-bold">
                <a href="login" class="text-slate-400 hover:text-white">← Volver a login</a>
                @if (ok)
                {
                    <a href="reset-password" class="text-blue-400 hover:text-blue-300">Ir a restablecer</a>
                }
            </div>
        </div>
    </div>
</div>

@code {
    private string email = "";
    private bool enviando = false;
    private string? mensaje;
    private bool ok = false;
    private string? devToken;

    private async Task Enviar()
    {
        if (string.IsNullOrWhiteSpace(email)) { mensaje = "Introduce un correo"; ok = false; return; }
        enviando = true; mensaje = null; devToken = null;
        var (okResp, msg, tok) = await AuthService.ForgotPassword(email.Trim());
        ok = okResp;
        mensaje = okResp ? "Si el correo existe, recibirás instrucciones. Revisa tu bandeja." : msg;
        devToken = tok;
        enviando = false;
    }

    private void IrAResetConToken()
    {
        if (string.IsNullOrEmpty(devToken) || string.IsNullOrWhiteSpace(email)) return;
        var url = $"reset-password?email={Uri.EscapeDataString(email.Trim())}&token={Uri.EscapeDataString(devToken)}";
        Navigation.NavigateTo(url);
    }
}
