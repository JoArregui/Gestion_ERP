<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ERP.Movil.ConfigPage"
             BackgroundColor="{StaticResource Black}">

    <ScrollView>
        <VerticalStackLayout
            Padding="20"
            Spacing="20">

            <Label Text="Configuración" Style="{StaticResource Headline}" TextColor="{StaticResource White}" />

            <Label Text="Ajustes del Sistema" Style="{StaticResource SubHeadline}" TextColor="{StaticResource Gray200}" />

            <VerticalStackLayout Spacing="10">
                <Border Stroke="{StaticResource Gray600}" StrokeThickness="1" Padding="12">
                    <Label x:Name="pickerBaseDatos" Text="Base de Datos" TextColor="{StaticResource White}" />
                </Border>
                <Border Stroke="{StaticResource Gray600}" StrokeThickness="1" Padding="12" Margin="0,0,0,8">
                    <Label x:Name="pickerVersion" Text="Versión" TextColor="{StaticResource White}" />
                </Border>
                <Border Stroke="{StaticResource Gray600}" StrokeThickness="1" Padding="12">
                    <Label x:Name="pickerActualizacion" Text="Actualización" TextColor="{StaticResource White}" />
                </Border>
            </VerticalStackLayout>

            <Button Text="Guardar Configuración" BackgroundColor="{StaticResource Primary}" TextColor="{StaticResource White}" Padding="12" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>