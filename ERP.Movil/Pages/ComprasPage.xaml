<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ERP.Movil.ComprasPage"
             BackgroundColor="{StaticResource Black}">

    <ScrollView>
        <VerticalStackLayout
            Padding="20"
            Spacing="20">

            <Label Text="Compras" Style="{StaticResource Headline}" TextColor="{StaticResource White}" />

            <Label Text="Nueva Compra" Style="{StaticResource SubHeadline}" TextColor="{StaticResource Gray200}" />

            <VerticalStackLayout Spacing="10">
                <Border Stroke="{StaticResource Gray600}" StrokeThickness="1" Padding="12">
                    <Label x:Name="pickerProveedor" Text="Proveedor" TextColor="{StaticResource White}" />
                </Border>
                <Border Stroke="{StaticResource Gray600}" StrokeThickness="1" Padding="12" Margin="0,0,0,8">
                    <Label x:Name="pickerArticulo" Text="Artículo" TextColor="{StaticResource White}" />
                </Border>
                <Border Stroke="{StaticResource Gray600}" StrokeThickness="1" Padding="12">
                    <Label x:Name="pickerCantidad" Text="Cantidad" TextColor="{StaticResource White}" />
                </Border>
            </VerticalStackLayout>

            <Button Text="Registrar Compra" BackgroundColor="{StaticResource Primary}" TextColor="{StaticResource White}" Padding="12" />

            <Label Text="Historial de Compras" Style="{StaticResource SubHeadline}" TextColor="{StaticResource Gray200}" Margin="0,20,0,10" />

            <VerticalStackLayout Spacing="8">
                <Border BackgroundColor="{StaticResource Gray900}" Padding="12" HeightRequest="80" />
                <Border BackgroundColor="{StaticResource Gray900}" Padding="12" HeightRequest="80" Margin="0,0,0,8" />
                <Border BackgroundColor="{StaticResource Gray900}" Padding="12" HeightRequest="80" Margin="0,0,0,8" />
            </VerticalStackLayout>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>