<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ERP.Movil.DashboardPage"
             BackgroundColor="{StaticResource Black}">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="20">

            <Label Text="Panel Principal" Style="{StaticResource Headline}" TextColor="{StaticResource White}" />

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <BoxView Grid.Row="0" Grid.Column="0" HeightRequest="120" Color="{StaticResource Primary}" />
                <Label Grid.Row="0" Grid.Column="0" Text="Ventas" TextColor="{StaticResource White}" VerticalOptions="End" HorizontalOptions="Center" />

                <BoxView Grid.Row="0" Grid.Column="1" HeightRequest="120" Color="#ef4444" />
                <Label Grid.Row="0" Grid.Column="1" Text="Compras" TextColor="{StaticResource White}" VerticalOptions="End" HorizontalOptions="Center" />

                <BoxView Grid.Row="1" Grid.Column="0" HeightRequest="120" Color="#10b981" />
                <Label Grid.Row="1" Grid.Column="0" Text="RR.HH" TextColor="{StaticResource White}" VerticalOptions="End" HorizontalOptions="Center" />

                <BoxView Grid.Row="1" Grid.Column="1" HeightRequest="120" Color="#3b82f6" />
                <Label Grid.Row="1" Grid.Column="1" Text="Stock" TextColor="{StaticResource White}" VerticalOptions="End" HorizontalOptions="Center" />
            </Grid>

            <Label Text="Últimas actividades" Style="{StaticResource SubHeadline}" TextColor="{StaticResource Gray200}" />

            <VerticalStackLayout Spacing="10">
                <Border Stroke="{StaticResource Gray600}" StrokeThickness="1" Padding="12">
                    <Label x:Name="lblHoy" Text="Hoy" TextColor="{StaticResource Gray300}" FontSize="14" />
                </Border>
                <Border Stroke="{StaticResource Gray600}" StrokeThickness="1" Padding="12" Margin="0,0,0,8">
                    <Label x:Name="lblEstaSemana" Text="Esta semana" TextColor="{StaticResource Gray300}" FontSize="14" />
                </Border>
                <Border Stroke="{StaticResource Gray600}" StrokeThickness="1" Padding="12">
                    <Label x:Name="lblEsteMes" Text="Este mes" TextColor="{StaticResource Gray300}" FontSize="14" />
                </Border>
            </VerticalStackLayout>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>