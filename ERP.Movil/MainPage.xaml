<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ERP.Movil.MainPage">

    <ScrollView>
        <VerticalStackLayout
            Padding="0"
            Spacing="20"
            BackgroundColor="{StaticResource Black}">
            <BoxView HeightRequest="60" Color="{StaticResource Primary}" />

            <Label
                Text="SISTEMA ERP"
                Style="{StaticResource Headline}"
                SemanticProperties.HeadingLevel="Level1"
                TextColor="{StaticResource White}"
                HorizontalOptions="Center" />

            <Label
                Text="ERP para PYMES"
                Style="{StaticResource SubHeadline}"
                TextColor="{StaticResource Gray200}"
                HorizontalOptions="Center" />

            <BoxView HeightRequest="1" Color="{StaticResource Gray600}" HorizontalOptions="Center" Margin="0,10,0,10" />

            <Button
                x:Name="btnDashboard"
                Text="Panel Principal"
                BackgroundColor="{StaticResource Primary}"
                TextColor="{StaticResource White}"
                FontAttributes="Bold"
                CornerRadius="8"
                Padding="20,10"
                HorizontalOptions="Center"
                Clicked="OnDashboardClicked" />

            <Button
                x:Name="btnVentas"
                Text="Ventas y TPV"
                BackgroundColor="{StaticResource Secondary}"
                TextColor="{StaticResource Black}"
                FontAttributes="Bold"
                CornerRadius="8"
                Padding="20,10"
                HorizontalOptions="Center"
                Clicked="OnVentasClicked" />

            <Button
                x:Name="btnCompras"
                Text="Compras"
                BackgroundColor="{StaticResource Secondary}"
                TextColor="{StaticResource Black}"
                FontAttributes="Bold"
                CornerRadius="8"
                Padding="20,10"
                HorizontalOptions="Center"
                Clicked="OnComprasClicked" />

            <Button
                x:Name="btnRRHH"
                Text="Recursos Humanos"
                BackgroundColor="{StaticResource Secondary}"
                TextColor="{StaticResource Black}"
                FontAttributes="Bold"
                CornerRadius="8"
                Padding="20,10"
                HorizontalOptions="Center"
                Clicked="OnRRHHClicked" />

            <Button
                x:Name="btnStock"
                Text="Inventario"
                BackgroundColor="{StaticResource Secondary}"
                TextColor="{StaticResource Black}"
                FontAttributes="Bold"
                CornerRadius="8"
                Padding="20,10"
                HorizontalOptions="Center"
                Clicked="OnStockClicked" />

            <Button
                x:Name="btnMaestros"
                Text="Maestros"
                BackgroundColor="{StaticResource Secondary}"
                TextColor="{StaticResource Black}"
                FontAttributes="Bold"
                CornerRadius="8"
                Padding="20,10"
                HorizontalOptions="Center"
                Clicked="OnMaestrosClicked" />

            <Button
                x:Name="btnConfig"
                Text="Configuración"
                BackgroundColor="{StaticResource Secondary}"
                TextColor="{StaticResource Black}"
                FontAttributes="Bold"
                CornerRadius="8"
                Padding="20,10"
                HorizontalOptions="Center"
                Clicked="OnConfigClicked" />
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
